<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>human_motion_predictor</name>
  <version>0.1.0</version>
  <description>Human upper-body motion prediction with the 19-DOF kinematic model of nioc (inverse optimal control).</description>
  <maintainer email="michele.ferrari@unibs.it">Michele Ferrari</maintainer>
  <license>GPL-3.0-only</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>zed_msgs</exec_depend>
  <exec_depend>human_motion_prediction_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
